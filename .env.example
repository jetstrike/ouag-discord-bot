# ==========================================
# Once Upon a Galaxy (OUAG) Discord Bot
# Environment Configuration
# ==========================================

# Discord Bot Credentials
# Get these from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_application_client_id_here
GUILD_ID=

# ==========================================
# Database Configuration
# ==========================================
# By default, the bot runs locally using SQLite (zero setup required).
# To connect your TiDB Cloud (or MySQL) database instead, set USE_TIDB=true:
USE_TIDB=false
TIDB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_tidb_username_here
TIDB_PASSWORD=your_tidb_password_here
TIDB_DATABASE=ouag_lobbies
TIDB_SSL=true
